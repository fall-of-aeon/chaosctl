{
  "id": "chaosW2async001",
  "name": "W2 async order",
  "active": false,
  "nodes": [
    {
      "id": "7ce42d88-761c-5a3d-9330-9d261fd76c70",
      "name": "webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "6f0a3c52-0b1e-4c4f-9d4b-000000000002",
      "parameters": {
        "httpMethod": "POST",
        "path": "chaos-w2",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "afa1b33a-2c7d-5010-93a8-c636004efe45",
      "name": "validate",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "request_id",
              "type": "string",
              "value": "={{ $json.body.request_id }}"
            },
            {
              "id": "a2",
              "name": "workflow",
              "type": "string",
              "value": "={{ $json.body.workflow }}"
            },
            {
              "id": "a3",
              "name": "received_at",
              "type": "string",
              "value": "={{ $json.body.received_at }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "7e57eaf8-5533-56d6-abf7-a1f6a7693d37",
      "name": "call mock-api",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://mock-api:8080/work",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "request_id",
              "value": "={{ $json.request_id }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "7a1fc88a-2cf4-5981-8d29-8d244a0ea08c",
      "name": "insert order",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgChaos0000001",
          "name": "chaos-postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO orders (request_id, workflow, received_at) VALUES ($1::uuid, $2, $3::timestamptz) RETURNING request_id::text, workflow",
        "options": {
          "queryReplacement": "={{ [$('validate').item.json.request_id, $('validate').item.json.workflow, $('validate').item.json.received_at] }}"
        }
      }
    }
  ],
  "connections": {
    "webhook": {
      "main": [
        [
          {
            "node": "validate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "validate": {
      "main": [
        [
          {
            "node": "call mock-api",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "call mock-api": {
      "main": [
        [
          {
            "node": "insert order",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
