{
  "id": "chaosW1sync0001",
  "name": "W1 sync order (customer waits)",
  "active": false,
  "nodes": [
    {
      "id": "cd4a8dde-d13b-54d1-a164-b5c9e9b14912",
      "name": "receive order",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "6f0a3c52-0b1e-4c4f-9d4b-000000000001",
      "parameters": {
        "httpMethod": "POST",
        "path": "chaos-w1",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "57ee3590-37ef-5932-b436-b103e06bdb09",
      "name": "call mock-api",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://mock-api:8080/work",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "request_id",
              "value": "={{ $json.body.request_id }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "435374d7-b1f8-5e69-9f9a-2abd353b0f22",
      "name": "save order",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgChaos0000001",
          "name": "chaos-postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO orders (request_id, workflow, received_at) VALUES ($1::uuid, $2, $3::timestamptz) RETURNING request_id::text, workflow",
        "options": {
          "queryReplacement": "={{ [$('receive order').item.json.body.request_id, $('receive order').item.json.body.workflow, $('receive order').item.json.body.received_at] }}"
        }
      }
    }
  ],
  "connections": {
    "receive order": {
      "main": [
        [
          {
            "node": "call mock-api",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "call mock-api": {
      "main": [
        [
          {
            "node": "save order",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
